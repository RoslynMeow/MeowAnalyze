{
  "name": "meowanalyze",
  "version": "0.1.0",
  "description": "A full-featured static code analyzer: language detection, cyclomatic complexity, nesting depth and more.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace @meowanalyze/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspace @meowanalyze/core",
    "build:web": "npm run build --workspace @meowanalyze/web",
    "dev": "tsx packages/cli/src/cli.ts",
    "dev:web": "npm run dev --workspace @meowanalyze/web",
    "bundle": "node scripts/bundle.mjs",
    "compile": "bun build packages/cli/src/cli.ts --compile --outfile dist/meowanalyze"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "bun": "^1.4.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
