{
  "name": "@meowanalyze/core",
  "version": "1.0.0",
  "description": "Browser-safe analysis core: language detection, cyclomatic complexity, nesting depth and more.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "static-analysis",
    "cyclomatic-complexity",
    "code-metrics"
  ],
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.7.2"
  }
}
